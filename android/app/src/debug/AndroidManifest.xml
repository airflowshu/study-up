<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- 只有 debug 包允许明文 HTTP。
         用途：本机联调时把服务地址指到局域网，例如在 flutter run 后面加
               dart-define API_BASE=http://192.168.1.100:8787
         不加这一条会在请求阶段直接失败，报错指向网络安全策略，
         看着像服务端挂了，其实是被 Android 9+ 的默认行为拦在半路。

         release 包不继承这个设置：main 的 application 里没有 usesCleartextTraffic，
         系统默认 false，只能走 HTTPS。所以正式分发的包不可能被降级成明文。

         注意：XML 注释里不能出现两个连续的减号，所以上面把参数名写成了
         「dart-define」而不是带横线的形式。 -->
    <application android:usesCleartextTraffic="true" />
</manifest>
