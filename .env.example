# 复制成 .env 后逐项填好。这个文件会被 .gitignore 排除，不要提交。

# 站点对外的域名（不带 https://）。Cloudflare 面板里的 Public Hostname 必须和它一致。
APP_HOST=study-up.example.xyz

# 隧道不在这套编排里：NAS 上已有一条常驻 cloudflared（compose 项目 cf_tunnel），
# 公网入口复用它，面板里加 hostname study-up -> http://api:8787 即可。
# 若要自己跑独立隧道，取消 compose 里被注释的 cloudflared 段并在此填 token。
# TUNNEL_TOKEN=

# 数据库密码。随便生成一串，之后不用再记。
#   openssl rand -hex 24
POSTGRES_PASSWORD=

# 签发登录 token 的密钥。至少 32 个字符。
# 换掉它 = 所有设备立刻掉线，必须重新登录一次。
#   openssl rand -hex 32
JWT_SECRET=

# 发版脚本用的后台令牌。至少 16 个字符。
#   openssl rand -hex 16
ADMIN_TOKEN=

# 腾讯云 COS（图片直传）。四项全填才启用；缺任一项图片就存本地卷、经隧道往返。
# 密钥请用 CAM 子账号、只授权这一个桶，不要用主账号密钥。
# 桶的 CORS 要放行站点域名的 PUT/GET/HEAD，否则浏览器直传会被拦。
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=ap-shanghai
